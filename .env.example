# Media uploads: leave unset for local disk, "s3" for AWS
# UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# AWS_ACL=public-read
# S3_ROOT_PATH=cms/production
# CDN_URL=https://cdn.example.com  (full URL; optional CloudFront in front of the bucket)
# AWS_ENDPOINT=  (S3-compatible stores such as MinIO only)
