{
  "kind": "collectionType",
  "collectionName": "firstblogs",
  "info": {
    "singularName": "firstblog",
    "pluralName": "firstblogs",
    "displayName": "FIRSTBLOG"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "author_blogs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::author-blog.author-blog",
      "mappedBy": "firstblog"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "firstblogs"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "firstblog"
    },
    "contentImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "addictioncates": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::addictioncate.addictioncate",
      "mappedBy": "firstblogs"
    },
    "tag": {
      "type": "string"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "mappedBy": "firstblogs"
    },
    "eyebrow": {
      "type": "string"
    },
    "authorName": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "authorSummary": {
      "type": "string"
    },
    "authorPhoto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "profileUrl": {
      "type": "string"
    },
    "authorInstagram": {
      "type": "string"
    },
    "updatedDate": {
      "type": "date"
    },
    "readTime": {
      "type": "string"
    },
    "guideEyebrow": {
      "type": "string"
    },
    "guideTitle": {
      "type": "string"
    },
    "guideSubtitle": {
      "type": "text"
    },
    "guideButtonLabel": {
      "type": "string"
    },
    "guideUrl": {
      "type": "string"
    },
    "guideBullets": {
      "type": "component",
      "repeatable": true,
      "component": "blog.takeaway-item"
    },
    "guideCover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "showGuide": {
      "type": "boolean",
      "default": false
    },
    "showKeyTakeaways": {
      "type": "boolean",
      "default": false
    },
    "key_takeaway": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::key-takeaway.key-takeaway",
      "mappedBy": "firstblog"
    },
    "social_links": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::social-link.social-link",
      "mappedBy": "firstblog"
    }
  }
}
